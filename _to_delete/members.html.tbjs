let _tbTab='be';
const _tbOpen={};
function tbTab(id){
  _tbTab=id;
  document.querySelectorAll('#sec-toolbox .vtab').forEach(t=>t.classList.remove('active'));
  document.getElementById('tbtab-'+id).classList.add('active');
  document.getElementById('tb-search-input').value='';
  tbRender(id,'');
}
function tbSearch(q){tbRender(_tbTab,q.toLowerCase().trim());}
function tbRender(tabId,query){
  const container=document.getElementById('tb-content');
  const section=TB_DATA[tabId];
  let html='<div class="tb-cats">';
  let total=0;
  section.cats.forEach((cat,ci)=>{
    const key=tabId+'-'+ci;
    const isOpen=_tbOpen[key]!==false;
    let fh='';let mc=0;
    cat.files.forEach(f=>{
      if(query&&!(f.c+' '+f.n).toLowerCase().includes(query))return;
      mc++;total++;
      fh+=`<div class="tb-file"><div class="tb-file-icon tb-icon-${f.e}">${f.e.toUpperCase()}</div><div class="tb-file-info">${f.c?`<div class="tb-file-code">${f.c}</div>`:''}<div class="tb-file-name" title="${f.n}">${f.n}</div></div><a class="tb-dl-btn" href="${cat.path}${f.f}" download title="Download"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></a></div>`;
    });
    if(query&&mc===0)return;
    const exp=(isOpen||query)?'expanded':'collapsed';
    const arw=(isOpen||query)?'open':'';
    html+=`<div class="tb-cat-group ${exp}" id="tb-cg-${key}"><button class="tb-cat-header ${arw}" onclick="tbToggle('${key}')"><span class="tb-cat-dot" style="background:${section.color}"></span>${cat.name}<span class="tb-cat-count">${mc} file${mc!==1?'s':''}</span><svg class="tb-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></button><div class="tb-files">${fh}</div></div>`;
  });
  if(total===0)html+='<div class="tb-no-results">No files match your search.</div>';
  container.innerHTML=html+'</div>';
}
function tbToggle(key){
  const el=document.getElementById('tb-cg-'+key);
  const hdr=el.querySelector('.tb-cat-header');
  const isOpen=el.classList.contains('expanded');
  _tbOpen[key]=!isOpen;
  el.classList.toggle('expanded',!isOpen);
  el.classList.toggle('collapsed',isOpen);
  hdr.classList.toggle('open',!isOpen);
}
(function(){['be','nss','tbt'].forEach(t=>{const n=TB_DATA[t].cats.reduce((s,c)=>s+c.files.length,0);const el=document.getElementById('tb-'+t+'-cnt');if(el)el.textContent=n;});})();
function loadToolboxSection(){if(!window._tbInit){tbRender('be','');window._tbInit=true;}}
